[project]
name = "myapp"
version = "0.1.0"
requires-python = ">=3.10"
// 런타임 의존성
dependencies = [
    "requests>=2.31",
    "pydantic>=2,<3",
    "numpy~=1.26",            # 1.26 이상, 1.27 미만
    "rich!=13.0.0",
    "uvloop; sys_platform != 'win32'",   # 환경 마커
    "tomli; python_version < '3.11'",
    "httpx[http2]>=0.27",                # 패키지의 extra 함께 설치
    "mylib @ git+https://github.com/me/mylib.git@v1.2.0",  # 직접 URL
]

// 선택적 의존성 (extras): optional-dependencies
// 사용자가 pip install myapp[postgres] 처럼 골라서 설치하는 기능 단위 의존성, 배포 패키지 메타데이터에 포함된다.
[project.optional-dependencies] // 해당 라벨을 필수로 넣어야 함.
postgres = ["psycopg[binary]>=3.1"]
redis = ["redis>=5"]
all = ["myapp[postgres,redis]"]   # 다른 extra 묶기

// 개발용 의존성 그룹 (PEP 735): dependency-groups
// 테스트, 린트, 문서처럼 개발할 때만 필요하고 배포 패키지에는 넣지 않을 의존성을 위한 표준. 지금 권장되는 방식이며, uv와 pip(pip install --group dev)지원
[dependency-groups]
test = ["pytest>=8", "pytest-cov"] // 그룹을 만들고
lint = ["ruff", "mypy"]
dev = [
    { include-group = "test" }, // 이쪽에서 포함시킴
    { include-group = "lint" },
    "ipython",
]

// 빌드 의존성: build-system
// 패키지를 빌드할 때 필요한 도구
[build-system]
requires=["hatchling>=1.24"]
build-backend="hatchling.build"

// 동적 의존성: dynamic
의존성을 다른파일 (예: requirements.txt) 에서 읽어오는 방식, setuptools 사용 시 예시는 다음
[project]
name = "myapp"
dynamic = ["dependencies", "optional-dependencies"] // 프로젝트 섹션에 dynamic 선언.

[tool.setuptools.dynamic]
dependencies = { file = ["requirements.txt"] }
optional-dependencies.dev = { file = ["requirements-dev.txt"] }


// uv 전용 출처 지정: tool.uv.sources
// 의존성 목록은 표준(project, dependency-groups)에 적고, 어디서 가져올지만 따로 지정
[project]
dependencies = ["mylib", "torch"] // 하단 tool.uv.sources에서 참조하여 가져옴.

[tool.uv.sources]
mylib = { path = "../mylib", editable = true } // 위에서 참조할 sources
torch = { index = "pytorch-cu121" }

[[tool.uv.index]]
name = "pytorch-cu121" // 해당 인덱스의 url을 지정
url = "https://download.pytorch.org/whl/cu121"
explicit = true





